{
  "name": "developer-control-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Developer Control Center (DCC) for managing Continue configs, running workflows, and creating Bitbucket Data Center PRs.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build:ui": "npm --prefix dcc_hub run build",
    "db:migrate": "node scripts/migrate.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "simple-git": "^3.25.0",
    "zod": "^3.23.8",
    "node-fetch": "^3.3.2"
  }
}
