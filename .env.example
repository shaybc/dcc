PORT=7331

# Path to local clone of your continue-configs-repo (the repo that contains .continue/)
CONFIG_REPO_PATH=/shared/continue-configs-repo

# Optional: restrict UI/API access (simple shared token). Leave empty to disable.
DCC_AUTH_TOKEN=

# Bitbucket Data Center base URL, e.g. https://bitbucket.company.local
BITBUCKET_BASE_URL=https://bitbucket.example.local

# Bitbucket credentials (Basic Auth). Prefer setting these at runtime, not committing.
BITBUCKET_USERNAME=
BITBUCKET_PASSWORD=

# Base branch to target for PRs
DEFAULT_BASE_BRANCH=main

# (Optional) OpenAI-compatible shim base URL for org Gemini REST (used by future workflow steps)
OPENAI_SHIM_BASE_URL=http://localhost:8080
OPENAI_SHIM_API_KEY=

# Gemini AI Studio (Google AI Studio)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004

# AI call logging (Mission-Control-like local audit)
AI_LOG_ENABLED=true
AI_LOG_REPLY_PREVIEW_CHARS=100

# Log OpenAI-style HTTP responses to the console for debugging
OPENAI_RESPONSE_LOG_ENABLED=false
